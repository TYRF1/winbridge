{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinBridge Fixture",
  "version": "0.1.0",
  "identifier": "dev.winbridge.fixture",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinBridge Fixture",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-sandbox"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["winbridge-fixture"]
      }
    }
  }
}
